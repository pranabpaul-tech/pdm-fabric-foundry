# Copy to .env and fill in. Loaded by common/config.py via python-dotenv.
# None of these are secrets — resource identifiers, not keys. Auth is always
# DefaultAzureCredential (az login), never a client secret in this file.
# `azd provision` (preprovision hook) writes the naming values below for you.

PDMOPS_SUBSCRIPTION_ID=
PDMOPS_RESOURCE_GROUP=rg-pdm-fabric-foundry
PDMOPS_LOCATION=swedencentral

PDMOPS_FABRIC_CAPACITY_NAME=pdmopsf8
PDMOPS_WORKSPACE_NAME=pdm-fabric-foundry

PDMOPS_EVENTHOUSE_NAME=pdmops-eventhouse
PDMOPS_KQL_DATABASE_NAME=pdmops-kql-db
PDMOPS_TABLE_NAME=telemetry_enriched
PDMOPS_RAW_TABLE_NAME=telemetry_raw

PDMOPS_EVENTSTREAM_NAME=es-pdm-downtime

PDMOPS_OPS_AGENT_NAME=PdM Operations Monitor
PDMOPS_TEAMS_CHANNEL_WEBHOOK_ID=

PDMOPS_FOUNDRY_ACCOUNT_NAME=
PDMOPS_FOUNDRY_PROJECT_NAME=pdm-agents
PDMOPS_FOUNDRY_AGENT_NAME=pdm-orchestrator

PDMOPS_KEY_VAULT_URI=

# state.json path, relative to the repo root unless absolute
PDMOPS_STATE_FILE=state.json
